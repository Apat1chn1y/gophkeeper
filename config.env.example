# GophKeeper server configuration.
#
# Copy this file to config.env, fill in the secrets, and load it:
#     set -a; . ./config.env; set +a
# Never commit config.env with real secrets.

# --- HTTP listener -------------------------------------------------------
GOPHKEEPER_HOST=127.0.0.1
GOPHKEEPER_PORT=8080

# --- Storage -------------------------------------------------------------
# SQLite file path. Use ":memory:" for a throwaway in-memory database.
GOPHKEEPER_STORAGE_DSN=gophkeeper.db

# --- Authentication ------------------------------------------------------
# HMAC key for signing JWT session tokens. At least 32 bytes.
# Generate with:  head -c 32 /dev/urandom | base64
GOPHKEEPER_JWT_SECRET=change-me-at-least-32-bytes-long!!!!!

# --- Encryption at rest --------------------------------------------------
# AES-256 key used to encrypt item payloads in the database.
# Must be exactly 32 bytes.
# Generate with:  head -c 32 /dev/urandom | base64 | head -c 32
GOPHKEEPER_ENCRYPTION_KEY=change-me-32-bytes-long!!!!!!!!

# --- Session -------------------------------------------------------------
# Token lifetime, e.g. 24h, 30m, 168h.
GOPHKEEPER_TOKEN_TTL=24h